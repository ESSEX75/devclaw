{
  "name": "@laurentenhoor/devclaw",
  "version": "1.6.10",
  "description": "Multi-project dev/qa pipeline orchestration for OpenClaw",
  "type": "module",
  "license": "MIT",
  "author": "Lauren ten Hoor <laurentenhoor@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/laurentenhoor/devclaw.git"
  },
  "bugs": {
    "url": "https://github.com/laurentenhoor/devclaw/issues"
  },
  "homepage": "https://github.com/laurentenhoor/devclaw#readme",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "dev-pipeline",
    "orchestration",
    "gitlab",
    "github",
    "multi-project"
  ],
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.5",
      "minGatewayVersion": "2026.9.5"
    },
    "build": {
      "openclawVersion": "2026.9.5",
      "pluginSdkVersion": "2026.9.5"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "defaults/",
    "roles/",
    "docs/",
    "openclaw.plugin.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint index.ts lib",
    "lint:fix": "eslint index.ts lib --fix",
    "prebuild": "npm run check && npm run lint",
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "test": "node scripts/run-node-tests.mjs",
    "arch:check": "node scripts/architecture-check.mjs --warn-only",
    "arch:check:strict": "node scripts/architecture-check.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "openclaw": "^2026.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.6",
    "cockatiel": "^4.0.0",
    "commander": "^15.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "knip": "^6.38.0",
    "openclaw": "2026.9.5",
    "ts-prune": "^0.10.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "unique-names-generator": "^4.7.1",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
